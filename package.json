{
  "name": "inmore-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Product configurator engine, the tenant configs that drive it, and the surfaces it ships on.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/site",
    "build": "npm run build --workspace apps/site",
    "preview": "npm run preview --workspace apps/site",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "models:inspect": "node tools/inspect-models.mjs",
    "models:axis": "node tools/panel-axis.mjs",
    "models:uv": "node tools/uv-map.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "draco3dgltf": "^1.5.7",
    "vitest": "^2.1.8"
  }
}
