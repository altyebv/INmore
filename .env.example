# Public runtime configuration. All values are exposed to the client.
VITE_CONTACT_ENDPOINT=
VITE_SITE_URL=https://inmore.qa
VITE_QREATE_URL=http://localhost:5174

# Orders go to the operations system (the inmore-ops repo). The key is the
# project's publishable key - never the service-role key. Leave both empty and
# the order page says ordering is not open yet.
# Local stack: http://127.0.0.1:54321 and the key `npx supabase status` prints.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
