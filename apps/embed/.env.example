# Public runtime configuration. All values are exposed to the client.

# Where tenant configs and models live: an R2 bucket laid out as
#   tenants/<tenant>/config.json
#   tenants/<tenant>/models/*.glb
#   shared/draco/
# The bucket's own r2.dev URL for now — rate-limited and uncached, so
# temporary until a custom domain replaces it. No trailing slash.
# Required. Nothing here is bundled any more (see vite.config.js), so left
# unset, every tenant config and model 404s — point this at your own R2
# bucket, or a local stand-in serving the same layout, to develop against.
VITE_ASSET_BASE=
